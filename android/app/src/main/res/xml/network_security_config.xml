<?xml version="1.0" encoding="utf-8"?>
<!--
  Network security policy for the FINIX demo build.

  Android 9 (API 28) and later block cleartext HTTP by default. The demo
  banking API is served over plain http:// on a developer machine, so without
  this file every request fails with CLEARTEXT_NOT_PERMITTED and the app
  silently falls back to its mock data.

  Cleartext is therefore allowed ONLY for local development hosts:
    10.0.2.2   - the host machine as seen from the Android emulator
    10.0.3.2   - the same, on Genymotion
    localhost / 127.0.0.1 - on-device port forwarding (adb reverse)
  Everything else keeps the secure default (cleartextTrafficPermitted="false"),
  so a real backend must be reached over HTTPS.

  For a physical device on the same Wi-Fi, add that machine's LAN address
  (e.g. <domain includeSubdomains="false">192.168.1.42</domain>) here as well.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.3.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
